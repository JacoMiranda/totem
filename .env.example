APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Proxy de IA (Gemini) - ver config/services.php e App\Services\Ai\GeminiAiService.
# Chave: aistudio.google.com/apikey. Formatos AIza... (antigo) e AQ....
# (novo, "auth key", restrito à API Gemini) - ambos funcionam, a chave vai
# no header x-goog-api-key. Chaves "standard" sem restrição serão rejeitadas
# até set/2026 (ai.google.dev/gemini-api/docs/api-key).
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-flash-lite-latest
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models

# LGPD (Fase 8) - dias de retenção antes do expurgo automático (ver
# config/ouvidoria.php e ouvidoria:expurgar-lgpd).
OUVIDORIA_RETENCAO_DIAS=730

VITE_APP_NAME="${APP_NAME}"

# Kiosk: true = NÃO usa a Gemini (transcreve com Vosk, classifica por léxico
# local). Ver resources/js/kiosk/lib/ia.ts.
VITE_KIOSK_IA_LOCAL=false

# Kiosk: true = tenta transcrever áudio localmente com Vosk (modelo WASM
# ~32 MB). Off por padrão - lib instável. Sem ele, o cidadão digita.
VITE_KIOSK_VOSK=false

# Service Worker/PWA: off em dev. Ligar na Fase 9 (deploy do totem).
VITE_PWA=false

# Kiosk: PIN do painel de manutenção do totem (segurar 3s o canto superior
# esquerdo -> PIN). TROCAR do default '0000' no build do totem físico.
# Ver docs/MODO-QUIOSQUE.md.
VITE_SUPORTE_PIN=0000
